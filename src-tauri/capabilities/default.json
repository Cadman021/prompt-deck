{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for main window",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    {
      "identifier": "sql:allow-execute",
      "allow": [{ "path": "* " }]
    },
    {
      "identifier": "sql:allow-select",
      "allow": [{ "path": "*" }]
    }
  ]
}